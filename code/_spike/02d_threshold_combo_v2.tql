# S5 v2: threshold-set 노드 조회 — 매개변수와 attribute 매칭 분리
# 핵심 패턴: has config-version $cv; $cv == $version_in;
define

fun s_priority_to_state_v2($sp_in: double, $version_in: string) -> { string }:
  match
    $t isa threshold-set,
      has config-version $cv,
      has th-low $lo,
      has th-mid-low $ml,
      has th-mid-high $mh,
      has th-high $hi;
    $cv == $version_in;
    {
      $sp_in < $lo;
      let $state = "GeneralManagement";
    } or {
      $sp_in >= $lo; $sp_in < $ml;
      let $state = "EnhancedMonitoring";
    } or {
      $sp_in >= $ml; $sp_in < $mh;
      let $state = "ReviewPreWatering";
    } or {
      $sp_in >= $mh; $sp_in < $hi;
      let $state = "PriorityPreWatering";
    } or {
      $sp_in >= $hi;
      let $state = "ImmediatePreWatering";
    };
  return { $state };
